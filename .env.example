# Server-only secrets. Never prefix API keys with NEXT_PUBLIC_.
# Use secure environment settings in cloud; .env.local for local development.
PLANS_OPENAI_API_KEY=
PLANS_OPENAI_MODEL=gpt-4.1-mini
# Enable Places API (New) and billing; restrict key to the required server APIs.
GOOGLE_MAPS_API_KEY=
# Optional: enable Routes API with the Maps key, or supply a separate server key.
PLANS_ENABLE_ROUTES=false
GOOGLE_ROUTES_API_KEY=
# Optional Google Maps Static API (map images proxied without exposing the key).
PLANS_ENABLE_STATIC_MAPS=false
# Process-wide hourly cap; maximum accepted setting is 100. Not a distributed quota.
PLANS_MAX_AI_CALLS_PER_HOUR=30
